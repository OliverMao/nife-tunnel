{
  "name": "nifetun",
  "version": "0.2.0",
  "description": "nife 插件：把本机端口通过自建 nifetun 隧道暴露到公网（纯 Node，无需打包）",
  "keywords": [
    "pi-package",
    "nife",
    "nifetun",
    "tunnel",
    "port-forward"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./nife-extension/index.ts"
    ]
  },
  "peerDependencies": {
    "nife-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "nife-extension",
    "scripts"
  ],
  "peerDependenciesMeta": {
    "nife-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "repository": "github:OliverMao/nife-tunnel"
}
